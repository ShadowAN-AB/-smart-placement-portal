PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/smart_placement_portal
# Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<url_encoded_password>@<cluster-host>/smart_placement_portal?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_strong_secret
ADMIN_SIGNUP_CODE=placement_admin_2026

# AI / LLM Provider Configuration
# LLM_PROVIDER selects the backend. Options: "ollama" (default, local) or "anthropic" (cloud API).
LLM_PROVIDER=ollama

# Ollama (local) — used when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Anthropic (cloud) — required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Email (leave SMTP_HOST unset in dev — emails will be logged to stdout instead of sent)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
EMAIL_FROM=Smart Placement Portal <no-reply@spp.local>

# Client URL used in password-reset links
APP_URL=http://localhost:5173
